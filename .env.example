# Secret key from https://www.atmee.ai/studio/api-keys (needs the "sessions" scope).
# Read by the bridge process only; it is never sent to the browser.
ATMEE_API_KEY=sk_atmee_...

# The id of a finished avatar your account owns.
ATMEE_AVATAR_ID=

# Optional: a non-production Atmee API (staging, or a mock for tests).
# ATMEE_API_BASE_URL=https://api.atmanity.us
